# Upstream Rethink Robotics packages, pinned to the exact commits used in the study.
# Fetch with:  wstool init src sawyer.rosinstall   (or: vcs import src < sawyer.rosinstall after converting)
- git: {local-name: intera_common,    uri: 'https://github.com/RethinkRobotics/intera_common.git',            version: a298fec02b8300e23841085a73c2039261c3d43c}
- git: {local-name: intera_sdk,       uri: 'https://github.com/RethinkRobotics/intera_sdk.git',               version: 6614dec1c5c2e7a74db1af6d01811d1332801785}
- git: {local-name: sawyer_moveit,    uri: 'https://github.com/RethinkRobotics/sawyer_moveit.git',            version: 18ad347ecae27386c853351e72607990c21d8850}
- git: {local-name: sawyer_robot,     uri: 'https://github.com/RethinkRobotics/sawyer_robot.git',             version: d1ef3d0ca83d0a943839783efd9b162e6930f2b7}
- git: {local-name: sawyer_simulator, uri: 'https://github.com/RethinkRobotics/sawyer_simulator.git',         version: 156bf1252a10246bbdebbbd020352cee7ec0b252}
- git: {local-name: sns_ik,           uri: 'https://github.com/RethinkRobotics-opensource/sns_ik.git',        version: 69f22830dfd3f4da59af38ba7fe2ea1014aa0db0}
